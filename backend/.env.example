# Server
PORT=5000
NODE_ENV=development

# PostgreSQL (matches docker-compose.yml)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/flightbooking
# Set to true only for external databases that require TLS
DATABASE_SSL=false

# Duffel — create a TEST token at https://app.duffel.com (Developers -> Access tokens).
# Test tokens start with "duffel_test_". The server refuses to start if the token
# does not match DUFFEL_MODE.
DUFFEL_ACCESS_TOKEN=
DUFFEL_MODE=test

# Safety switch: real (live) orders are only ever created when DUFFEL_MODE=live
# AND this is set to true. Leave false for development.
DUFFEL_LIVE_BOOKINGS_ENABLED=false

# Webhook signing secret shown when you create a webhook in the Duffel dashboard.
DUFFEL_WEBHOOK_SECRET=

# Duffel request timeout in milliseconds (offer requests can take a while)
DUFFEL_TIMEOUT_MS=30000

# Allowed browser origin(s), comma separated
FRONTEND_URL=http://localhost:5173
